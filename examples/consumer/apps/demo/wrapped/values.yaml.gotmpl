chart:                                  # → source A (upstream podinfo)
  replicaCount: 2
  ui:
    message: "from {{ .Values.cluster.domain }}"
localGreeting: "hi-from-{{ .Values.cluster.domain }}"   # → source B (local chart)
# The local chart's templates read these; the loader passes only what this file says.
cluster:
  argocdNamespace: {{ .Values.cluster.argocdNamespace | toJson }}
  domain: {{ .Values.cluster.domain | toJson }}
