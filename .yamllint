---
extends: default

ignore: |
  templates/
  examples/consumer/templates/
  examples/consumer/apps/*/*/templates/
  charts/
  examples/consumer/charts/
  test/unit/**/invalid-*/
  test/golden/

rules:
  line-length:
    max: 160
    allow-non-breakable-words: true
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    forbid: non-empty
  document-start: disable
  truthy:
    check-keys: false
