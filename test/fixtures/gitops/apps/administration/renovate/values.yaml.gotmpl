# =============================================================================
# Renovate — isolated dependency bot. CronJob in its OWN namespace (NOT the
# CI runner ns), broad egress, no ingress. Connects to Forgejo (in-cluster
# HTTP) with its own token (terraform/forgejo → providers/forgejo-renovate) and opens PRs against aeglanee/homelab. WHAT it
# updates + the auto-merge policy live in the repo's renovate.json — this file is
# just HOW it connects + runs.
# =============================================================================
chart:
  renovate:
    # Global self-hosted config. The update RULES are in the repo's renovate.json;
    # this is only the host wiring. Token comes from RENOVATE_TOKEN (existingSecret).
    config: |
      {
        "platform": "gitea",
        "endpoint": "http://forgejo-http.forgejo.svc:3000/",
        "autodiscover": false,
        "repositories": ["{{ .Values.cluster.forgejoUser }}/homelab"],
        "gitAuthor": "Renovate Bot <renovate@{{ .Values.cluster.domain }}>",
        "onboarding": false,
        "requireConfig": "optional"
      }

  cronjob:
    schedule: "0 */8 * * *"    # every 8h (00:00/08:00/16:00) — drains the backlog faster while testing
    concurrencyPolicy: Forbid  # never overlap runs

  # ESO renders this Secret (key RENOVATE_TOKEN = providers/forgejo-renovate).
  existingSecret: renovate-secret

  env:
    LOG_LEVEL: info
    RENOVATE_REPOSITORY_CACHE: enabled

  resources:
    requests:
      memory: 512Mi
