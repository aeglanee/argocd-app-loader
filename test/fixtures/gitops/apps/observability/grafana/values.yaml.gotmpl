# =============================================================================
# Values for the upstream grafana chart (OCI ghcr.io/grafana-community → Harbor ghcr-proxy when
# cluster.mirrors.via.harbor is enabled). Standalone Grafana, extracted from the victoria-metrics-k8s-stack
# subchart into its own ns. Authentik OIDC (generic_oauth) + the VictoriaMetrics datasource
# (cross-ns) + the dashboard sidecar. Dashboards stay declarative (sidecar-adopted CMs).
# =============================================================================
chart:
  fullnameOverride: grafana   # clean service name → grafana.grafana.svc:80

  # The VictoriaLogs datasource is a plugin (not built in). Grafana installs it at startup via runtime
  # egress (same path the openmeteo widget uses) and it persists in the PVC. Enables native LogsQL.
  plugins:
    - victoriametrics-logs-datasource

  # Admin login is BREAK-GLASS (Authentik OIDC is primary). The chart mints a random
  # admin-password each render → app.yaml ignoreDifferences pins it so ArgoCD doesn't churn it.
  # Break-glass access: read the live `grafana` secret's admin-password.

  ingress:
    enabled: false            # exposed via our own HTTPRoute (templates/httproute.yaml)

  # RWO PVC: a rolling update would wait forever for the old pod to release the volume.
  deploymentStrategy:
    type: Recreate

  persistence:
    enabled: true             # keep the grafana DB (users created on OIDC login, prefs) across restarts
    size: 5Gi

  testFramework:
    enabled: false

  # VictoriaMetrics datasource — explicit + cross-ns (the VM-stack's auto-provisioned datasource
  # CM is pruned with the subchart grafana). FQDN works today; add a NetworkPolicy allow with the
  # ns hardening pass.
  datasources:
    datasources.yaml:
      apiVersion: 1
      datasources:
        - name: VictoriaMetrics
          type: prometheus
          access: proxy
          url: http://vmsingle-victoria-metrics-k8s-stack.monitoring.svc:8428
          isDefault: true
        - name: VictoriaLogs
          type: victoriametrics-logs-datasource   # provided by the plugin below (native LogsQL)
          access: proxy
          url: http://victoria-logs-server.monitoring.svc:9428

  # Dashboard sidecar — adopts any CM labeled grafana_dashboard=1 across namespaces (VM default
  # dashboards still in monitoring + our own in the grafana ns). Datasource sidecar off (static above).
  sidecar:
    resources:
      requests:
        memory: 96Mi
    dashboards:
      enabled: true
      label: grafana_dashboard
      searchNamespace: ALL
    datasources:
      enabled: false

{{- if .Values.cluster.features.oidc }}
  # OIDC client secret → env; grafana maps GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET onto the
  # [auth.generic_oauth] client_secret. Secret grafana-oidc ← ESO ← OpenBao apps/grafana/oidc.
  envValueFrom:
    GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
      secretKeyRef:
        name: grafana-oidc
        key: clientSecret
{{- end }}

  grafana.ini:
    server:
      root_url: https://grafana.{{ .Values.cluster.domain }}
    # Land on our hardware overview (dashboards/homelab-overview.json). A redirect by dashboard UID,
    # not default_home_dashboard_path: that one 500s the home page whenever its file is missing.
    users:
      home_page: /d/homelab-overview
{{- if .Values.cluster.features.oidc }}
    auth.generic_oauth:
      enabled: true
      name: Authentik
      client_id: grafana
      scopes: "openid profile email groups"
      auth_url: https://authentik.{{ .Values.cluster.domain }}/application/o/authorize/
      token_url: https://authentik.{{ .Values.cluster.domain }}/application/o/token/
      api_url: https://authentik.{{ .Values.cluster.domain }}/application/o/userinfo/
      # grafana-admin → Admin, grafana-viewer → Viewer, anyone else is refused (strict). Groups
      # come from the authentik blueprint's groups claim.
      role_attribute_path: "contains(groups[*], 'grafana-admin') && 'Admin' || contains(groups[*], 'grafana-viewer') && 'Viewer'"
      role_attribute_strict: true
      allow_assign_grafana_admin: true
      auto_login: false
{{- end }}

  resources:
    requests:
      memory: 768Mi
